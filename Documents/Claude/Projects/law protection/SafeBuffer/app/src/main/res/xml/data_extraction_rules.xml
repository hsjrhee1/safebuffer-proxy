<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ 백업/데이터 이전 규칙
    SafeBuffer는 녹음 파일 및 DB를 백업하지 않음 (보안)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
