<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 핵심 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicePermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+ 알림 권한 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 배터리 최적화 제외 요청 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 기기 재부팅 후 자동 재시작 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        녹음 중 CPU 유지 — Doze 상태에서 청크 회전 타이머(코루틴 delay)가 멈추면
        MP4 가 finalize 되지 않아 그때까지의 녹음이 통째로 손상된다.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SafeBufferApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeBuffer">

        <!-- 메인 화면 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.evidence.LockedEvidenceActivity" />

        <!--
            핵심: Foreground Service (마이크 타입)
            Android 14부터 foregroundServiceType 명시 필수
        -->
        <service
            android:name=".service.RecordingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- PDF 공유용 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            tools:ignore="Typos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            WorkManager — 48시간 청크 자동삭제
            CleanupWorker 가 @HiltWorker 이므로 기본 initializer 를 제거하고
            SafeBufferApp(Configuration.Provider) 의 HiltWorkerFactory 로 on-demand 초기화한다.
            (기본 initializer 를 남겨두면 기본 WorkerFactory 가 CleanupWorker 생성에 실패해
             자동삭제가 전혀 동작하지 않는다)
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- 대화 타임라인 화면 -->
        <activity
            android:name=".ui.transcript.TranscriptActivity"
            android:exported="false" />

        <!-- API 키 설정 화면 -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <!-- 부팅 후 서비스 재시작 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
